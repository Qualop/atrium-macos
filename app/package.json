{
  "name": "atrium-app",
  "private": true,
  "version": "0.2.0",
  "description": "Atrium window: an infinite canvas of CLI agent sessions (Electron, React, xterm.js)",
  "license": "MIT",
  "type": "module",
  "main": "src/main/main.mjs",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "setup:mac": "node scripts/setup-macos.mjs",
    "mac": "node scripts/start-macos.mjs",
    "test:mac": "node test/e2e/mac-smoke.mjs",
    "test:mac:stress": "ATRIUM_STRESS=1 node test/e2e/mac-smoke.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron . --dev",
    "real": "node scripts/build.mjs && electron .",
    "test": "node --test test/*.test.mjs",
    "package:mac": "node scripts/package-macos.mjs",
    "release:mac": "node scripts/release-macos.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/nanum-gothic-coding": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1"
  },
  "allowScripts": {
    "electron@45.1.0": true,
    "esbuild@0.28.2": true
  }
}
